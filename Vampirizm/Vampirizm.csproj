<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net462</TargetFramework>
        <LangVersion>8.0</LangVersion>
        <Nullable>disable</Nullable>
        <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
        <!-- Unity supplies its own netstandard facade. -->
        <ImplicitlyExpandNETStandardFacades>false</ImplicitlyExpandNETStandardFacades>
        <VampirizmDeployPath Condition="'$(MOD_DEPLOYPATH)' != ''">$(MOD_DEPLOYPATH)</VampirizmDeployPath>
        <VampirizmDeployPath Condition="'$(VampirizmDeployPath)' == ''">/home/igentuman/.local/share/Steam/steamapps/common/Valheim/BepInEx/plugins/Vampirizm</VampirizmDeployPath>
        <DeployVampirizmOnBuild Condition="'$(DeployVampirizmOnBuild)' == ''">true</DeployVampirizmOnBuild>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="JotunnLib" Version="[2.29.2]" />
        <!-- Use the installed game, not a potentially stale publicized copy. -->
        <Reference Remove="assembly_*_publicized;SoftReferenceableAssets_publicized;gui_framework_publicized" />
        <Reference Include="assembly_valheim">
            <HintPath>$(VALHEIM_MANAGED)/assembly_valheim.dll</HintPath>
            <Private>false</Private>
        </Reference>
        <Reference Include="assembly_utils">
            <HintPath>$(VALHEIM_MANAGED)/assembly_utils.dll</HintPath>
            <Private>false</Private>
        </Reference>
        <Reference Include="assembly_guiutils">
            <HintPath>$(VALHEIM_MANAGED)/assembly_guiutils.dll</HintPath>
            <Private>false</Private>
        </Reference>
        <Reference Include="Newtonsoft.Json">
            <HintPath>$(VALHEIM_MANAGED)/Newtonsoft.Json.dll</HintPath>
            <Private>false</Private>
        </Reference>
        <Reference Include="SoftReferenceableAssets">
            <HintPath>$(VALHEIM_MANAGED)/SoftReferenceableAssets.dll</HintPath>
            <Private>false</Private>
        </Reference>
        <Reference Include="netstandard">
            <HintPath>$(VALHEIM_MANAGED)/netstandard.dll</HintPath>
            <Private>false</Private>
        </Reference>
    </ItemGroup>
    <ItemGroup>
        <!-- Original Blender meshes, rendered hammer icons and tileable coffin textures. -->
        <EmbeddedResource Include="Assets/Coffins/*.json" LogicalName="Vampirizm.Assets.%(Filename)%(Extension)" />
        <EmbeddedResource Include="Assets/*coffin*.png" LogicalName="Vampirizm.Assets.%(Filename)%(Extension)" />
        <!-- Generated by Assets/generate_rune_icon.py; embedded so only the DLL is deployed. -->
        <EmbeddedResource Include="Assets/vampire_rune.png" LogicalName="Vampirizm.Assets.vampire_rune.png" />
        <EmbeddedResource Include="Assets/bloody_stew.png" LogicalName="Vampirizm.Assets.bloody_stew.png" />
        <EmbeddedResource Include="Assets/crimson_jerky.png" LogicalName="Vampirizm.Assets.crimson_jerky.png" />
        <EmbeddedResource Include="Assets/hunters_tartare.png" LogicalName="Vampirizm.Assets.hunters_tartare.png" />
        <EmbeddedResource Include="Assets/black_blood_pudding.png" LogicalName="Vampirizm.Assets.black_blood_pudding.png" />
        <EmbeddedResource Include="Assets/seeker_blood_jelly.png" LogicalName="Vampirizm.Assets.seeker_blood_jelly.png" />
        <EmbeddedResource Include="Assets/serpent_blood_aspic.png" LogicalName="Vampirizm.Assets.serpent_blood_aspic.png" />
        <!-- World-model textures generated by Assets/generate_food_textures.py. -->
        <EmbeddedResource Include="Assets/tex_bloody_stew.png" LogicalName="Vampirizm.Assets.tex_bloody_stew.png" />
        <EmbeddedResource Include="Assets/tex_crimson_jerky.png" LogicalName="Vampirizm.Assets.tex_crimson_jerky.png" />
        <EmbeddedResource Include="Assets/tex_hunters_tartare.png" LogicalName="Vampirizm.Assets.tex_hunters_tartare.png" />
        <EmbeddedResource Include="Assets/tex_black_blood_pudding.png" LogicalName="Vampirizm.Assets.tex_black_blood_pudding.png" />
        <EmbeddedResource Include="Assets/tex_seeker_blood_jelly.png" LogicalName="Vampirizm.Assets.tex_seeker_blood_jelly.png" />
        <EmbeddedResource Include="Assets/tex_seeker_blood_jelly_outer.png" LogicalName="Vampirizm.Assets.tex_seeker_blood_jelly_outer.png" />
        <EmbeddedResource Include="Assets/tex_serpent_blood_aspic.png" LogicalName="Vampirizm.Assets.tex_serpent_blood_aspic.png" />
        <EmbeddedResource Include="Assets/bloodrage.png" LogicalName="Vampirizm.Assets.bloodrage.png" />
        <EmbeddedResource Include="Assets/bloodrage_gui.png" LogicalName="Vampirizm.Assets.bloodrage_gui.png" />
        <EmbeddedResource Include="Assets/bat.png" LogicalName="Vampirizm.Assets.bat.png" />
        <EmbeddedResource Include="Assets/invisibility.png" LogicalName="Vampirizm.Assets.invisibility.png" />
        <EmbeddedResource Include="Assets/dash.png" LogicalName="Vampirizm.Assets.dash.png" />
        <EmbeddedResource Include="Assets/orb_of_vampire.png" LogicalName="Vampirizm.Assets.orb_of_vampire.png" />
        <EmbeddedResource Include="Assets/tex_orb_of_vampire.png" LogicalName="Vampirizm.Assets.tex_orb_of_vampire.png" />
    </ItemGroup>
    <ItemGroup>
      <Folder Include="Assets\boss\" />
    </ItemGroup>
    <Target Name="DeployVampirizm" AfterTargets="Build" Condition="'$(DeployVampirizmOnBuild)' == 'true' and '$(DesignTimeBuild)' != 'true' and '$(VampirizmDeployPath)' != ''">
        <MakeDir Directories="$(VampirizmDeployPath)" />
        <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(VampirizmDeployPath)" SkipUnchangedFiles="true" />
        <Message Importance="High" Text="Deployed $(TargetFileName) to $(VampirizmDeployPath)" />
    </Target>
</Project>
