<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net462</TargetFramework>
        <LangVersion>8.0</LangVersion>
        <Nullable>disable</Nullable>
        <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
        <!-- Unity supplies its own netstandard facade. -->
        <ImplicitlyExpandNETStandardFacades>false</ImplicitlyExpandNETStandardFacades>
        <VampirizmDeployPath Condition="'$(MOD_DEPLOYPATH)' != ''">$(MOD_DEPLOYPATH)</VampirizmDeployPath>
        <VampirizmDeployPath Condition="'$(VampirizmDeployPath)' == ''">/home/igentuman/.local/share/Steam/steamapps/common/Valheim/BepInEx/plugins/Vampirizm</VampirizmDeployPath>
        <DeployVampirizmOnBuild Condition="'$(DeployVampirizmOnBuild)' == ''">true</DeployVampirizmOnBuild>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="JotunnLib" Version="[2.29.2]" />
        <!-- Use the installed game, not a potentially stale publicized copy. -->
        <Reference Remove="assembly_*_publicized;SoftReferenceableAssets_publicized;gui_framework_publicized" />
        <Reference Include="assembly_valheim">
            <HintPath>$(VALHEIM_MANAGED)/assembly_valheim.dll</HintPath>
            <Private>false</Private>
        </Reference>
        <Reference Include="assembly_utils">
            <HintPath>$(VALHEIM_MANAGED)/assembly_utils.dll</HintPath>
            <Private>false</Private>
        </Reference>
        <Reference Include="assembly_guiutils">
            <HintPath>$(VALHEIM_MANAGED)/assembly_guiutils.dll</HintPath>
            <Private>false</Private>
        </Reference>
        <Reference Include="SoftReferenceableAssets">
            <HintPath>$(VALHEIM_MANAGED)/SoftReferenceableAssets.dll</HintPath>
            <Private>false</Private>
        </Reference>
        <Reference Include="netstandard">
            <HintPath>$(VALHEIM_MANAGED)/netstandard.dll</HintPath>
            <Private>false</Private>
        </Reference>
    </ItemGroup>
    <ItemGroup>
        <!-- Generated by Assets/generate_rune_icon.py; embedded so only the DLL is deployed. -->
        <EmbeddedResource Include="Assets/vampire_rune.png" LogicalName="Vampirizm.Assets.vampire_rune.png" />
    </ItemGroup>
    <Target Name="DeployVampirizm" AfterTargets="Build" Condition="'$(DeployVampirizmOnBuild)' == 'true' and '$(DesignTimeBuild)' != 'true' and '$(VampirizmDeployPath)' != ''">
        <MakeDir Directories="$(VampirizmDeployPath)" />
        <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(VampirizmDeployPath)" SkipUnchangedFiles="true" />
        <Message Importance="High" Text="Deployed $(TargetFileName) to $(VampirizmDeployPath)" />
    </Target>
</Project>
